# Copy this file to .env and fill in your own values. Never commit .env.

# YouTube Data API v3 (Google Cloud console)
YOUTUBE_API_KEY=

# Podcast Index API (api.podcastindex.org): needs a key and a secret
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Google Gemini API key (aistudio.google.com) for the creator check in verify
LLM_API_KEY=

# Seed test (seedtest.py, Phase 6): ONLY your own test accounts. The engine never sends anywhere else.
# Sender: a Gmail account with 2-step verification and an App Password (myaccount.google.com/apppasswords).
# HOST/PORT may stay blank: Gmail (smtp.gmail.com:587, imap.gmail.com) is the default.
SEED_SMTP_USER=
SEED_SMTP_PASSWORD=
SEED_SMTP_HOST=
SEED_SMTP_PORT=
SEED_IMAP_HOST=
# Receiver: your second test Gmail address, and your second LinkedIn and Instagram test accounts
SEED_TO_EMAIL=
SEED_LINKEDIN_TO=
SEED_INSTAGRAM_TO=
